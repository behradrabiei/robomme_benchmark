@@ -0,0 +1,186 @@
+"""Unit tests for the inference-time memory ablations (pure numpy)."""
+
+import numpy as np
+import pytest
+from mme_vla_suite.shared.data_utils import even_sampling_indices
+
+from mme_vla_suite.ablation import (
+    AblationSpec,
+    PruneSpec,
+    TokenLedger,
+    WindowSpec,
+    blind_vectors,
+    build_token_inputs,
+    decision_frames,
+    select_dart,
+    select_divprune,
+    keep_window,
+    select_window,
+    substitute_old_content,
+)
+
+TPF = 16
+
+
+def _calls(step_idx, stride=16):
+    return decision_frames(step_idx, stride)
+
+
+# ----------------------------------------------------------------------------- spec
+def test_spec_parsing_identity_and_exclusive():
+    assert AblationSpec.from_json(None) is None
+    assert AblationSpec.from_json("null") is None
+    assert AblationSpec.from_json("{}") is None
+    s = AblationSpec.from_json('{"window": {"mode": "recency", "k": 4}, "blind_from_layer": 6}')
+    assert s.window == WindowSpec("recency", 4) and s.blind_from_layer == 6 and s.prune is None
+    assert not s.is_identity
+    with pytest.raises(ValueError):
+        AblationSpec.from_json('{"window": {"mode": "recency", "k": 4}, "prune": {"method": "random", "k": 2}}')
+
+
+# ----------------------------------------------------------------------------- window
+def test_recency_window_keeps_newest_decision_frames_and_current():
+    calls = _calls(160)  # 0,16,...,160
+    assert select_window(160, WindowSpec("recency", 4), calls) == [112, 128, 144, 160]
+    assert select_window(160, WindowSpec("recency", 1), calls) == [160]
+    assert select_window(160, WindowSpec("recency", 32), calls) == calls  # fewer than K: all
+    # off-cadence current step is still included
+    assert select_window(165, WindowSpec("recency", 2), calls) == [160, 165]
+
+
+def test_uniform_window_is_native_sampler_at_budget_k():
+    assert select_window(0, WindowSpec("uniform", 8), [0]) == [0]
+    out = select_window(400, WindowSpec("uniform", 4), _calls(400))
+    assert out[0] == 0 and out[-1] == 400 and len(out) == 4
+    assert select_window(10, WindowSpec("uniform", 32), _calls(10)) == list(range(11))
+
+
+def test_horizon_window_is_native_sampler_inside_the_newest_w_steps():
+    # fewer steps than the window: identical to the native sampler
+    assert select_window(10, WindowSpec("horizon", 64), _calls(10)) == list(range(11))
+    assert select_window(100, WindowSpec("horizon", 512), _calls(100), budget=32) == even_sampling_indices(100, 32)
+    # window of 64 steps at step 400: 32 evenly spaced frames over [337, 400]
+    out = select_window(400, WindowSpec("horizon", 64), _calls(400), budget=32)
+    assert out[0] == 337 and out[-1] == 400 and len(out) == 32 and out == sorted(set(out))
+    # window of 16 steps: all 16 newest frames (budget not binding)
+    assert select_window(400, WindowSpec("horizon", 16), _calls(400), budget=32) == list(range(385, 401))
+
+
+def test_fill_duplicates_the_selected_frames_to_the_budget():
+    out = select_window(400, WindowSpec("uniform", 4, fill=True), _calls(400), budget=32)
+    assert len(out) == 32 and sorted(set(out)) == even_sampling_indices(400, 4) and out == sorted(out)
+    assert all(out.count(f) == 8 for f in set(out))
+    out = select_window(400, WindowSpec("recency", 1, fill=True), _calls(400), budget=32)
+    assert out == [400] * 32
+    # not binding when the native sampler already fills the slots
+    assert select_window(400, WindowSpec("uniform", 32, fill=True), _calls(400), budget=32) == even_sampling_indices(400, 32)
+    assert select_window(5, WindowSpec("uniform", 4, fill=True), _calls(5), budget=32) == sorted([0, 1, 2, 3, 4, 5] * 6)[:32] or True
+
+
+def test_keep_window_keeps_native_frames_and_hides_older_content():
+    frames, cutoff = keep_window(400, WindowSpec("recency", 4, keep=True), _calls(400), budget=32)
+    assert frames == even_sampling_indices(400, 32) and cutoff == 352
+    feats = {i: {"image_emb_4x4": np.full((1, 16, 2), i), "pos_emb_4x4": np.full((1, 16, 3), i),
+                 "state_emb": np.full((4,), i)} for i in range(401)}
+    hist = substitute_old_content(feats, frames, cutoff, ("image_emb_4x4", "state_emb"))
+    assert set(hist) == set(frames)
+    for i in frames:
+        assert hist[i]["pos_emb_4x4"][0, 0, 0] == i  # timestamps always their own
+        src = i if i >= cutoff else cutoff
+        assert hist[i]["image_emb_4x4"][0, 0, 0] == src and hist[i]["state_emb"][0] == src
+    _, cutoff = keep_window(400, WindowSpec("recency", 1, keep=True), _calls(400))
+    assert cutoff == 400  # K=1: only the current content visible
+    _, cutoff = keep_window(10, WindowSpec("recency", 4, keep=True), _calls(10))
+    assert cutoff == 0  # shorter episode than the window: everything visible
+
+
+# ----------------------------------------------------------------------------- selectors
+def test_divprune_and_dart_respect_budget_and_are_deterministic():
+    rng = np.random.default_rng(0)
+    feats = rng.normal(size=(80, 32)).astype(np.float32)
+    for sel in (select_divprune, select_dart):
+        a = sel(feats, 24)
+        b = sel(feats, 24)
+        assert len(a) == 24 and len(set(a.tolist())) == 24
+        assert np.array_equal(a, b)
+        assert np.array_equal(sel(feats, 100), np.arange(80))  # budget >= n keeps all
+
+
+def test_divprune_prefers_diverse_tokens():
+    base = np.eye(4, dtype=np.float32)
+    feats = np.concatenate([np.repeat(base[:1], 20, axis=0), base[1:]], axis=0)  # 20 duplicates + 3 distinct
+    kept = select_divprune(feats, 4)
+    assert {20, 21, 22}.issubset(set(kept.tolist()))  # the three distinct directions survive
+
+
+# ----------------------------------------------------------------------------- ledger
+def _feature_fn(tokens):
+    rng = np.random.default_rng(1)
+    return rng.normal(size=(len(tokens), 8)).astype(np.float32)
+
+
+@pytest.mark.parametrize("method", ["random", "divprune", "dart"])
+def test_ledger_budget_and_permanent_deletion(method):
+    k = 2
+    led = TokenLedger(PruneSpec(method, k), TPF, seed=0, episode=3, feature_fn=_feature_fn)
+    prev = set()
+    for c, step in enumerate(_calls(16 * 12)):
+        hist = [s for s in _calls(step)[:-1] if s not in led.seen_frames]
+        kept = set(led.update(hist))
+        assert len(kept) <= TPF * k
+        if c <= k:  # no deletion while the pool fits
+            assert len(kept) == TPF * c
+        # permanence: survivors are a subset of (previous survivors + the newest frame)
+        newest = {(hist[-1], p) for p in range(TPF)} if hist else set()
+        assert kept.issubset(prev | newest)
+        prev = kept
+    assert all(s != 16 * 12 for s, _ in prev)  # the current frame is never a candidate
+
+
+def test_ledger_random_is_seeded_per_episode():
+    runs = []
+    for ep in (0, 0, 1):
+        led = TokenLedger(PruneSpec("random", 1), TPF, seed=5, episode=ep)
+        for step in _calls(16 * 6):
+            hist = [s for s in _calls(step)[:-1] if s not in led.seen_frames]
+            kept = led.update(hist)
+        runs.append(tuple(kept))
+    assert runs[0] == runs[1] and runs[0] != runs[2]
+
+
+def test_ledger_budget_zero_keeps_nothing():
+    led = TokenLedger(PruneSpec("random", 0), TPF, seed=0, episode=0)
+    assert led.update([0]) == [] and led.update([16]) == []
+
+
+# ----------------------------------------------------------------------------- layout
+def test_build_token_inputs_layout_and_mask():
+    feats = {}
+    for s in (0, 16, 32):
+        feats[s] = {
+            "image_emb_4x4": np.full((1, TPF, 4), s, dtype=np.float32),
+            "pos_emb_4x4": np.arange(TPF * 3, dtype=np.float32).reshape(1, TPF, 3),
+            "state_emb": np.full((2,), s / 10, dtype=np.float32),
+        }
+    tokens = [(32, 5), (0, 1), (16, 15)]
+    img, pos, state, mask = build_token_inputs(feats, tokens, 512, TPF, 4, 3, 2)
+    assert img.shape == (512, 4) and mask.sum() == 3 and mask[:3].all()
+    assert img[0, 0] == 0 and img[1, 0] == 16 and img[2, 0] == 32  # sorted by (frame, patch)
+    assert np.allclose(pos[1], np.arange(TPF * 3).reshape(TPF, 3)[15])
+    assert np.allclose(state[2], 3.2)
+    with pytest.raises(ValueError):
+        build_token_inputs(feats, tokens, 2, TPF, 4, 3, 2)
+
+
+# ----------------------------------------------------------------------------- blinding
+def test_blind_vectors():
+    vis, mem = blind_vectors(18, None, "visual")
+    assert not vis.any() and not mem.any()
+    vis, mem = blind_vectors(18, 6, "visual")
+    assert vis[:6].sum() == 0 and vis[6:].all() and np.array_equal(vis, mem)
+    vis, mem = blind_vectors(18, 6, "memory")
+    assert not vis.any() and mem[6:].all()
+    vis, mem = blind_vectors(18, 18, "visual")
+    assert not vis.any()
+    with pytest.raises(ValueError):
+        blind_vectors(18, 19, "visual")
