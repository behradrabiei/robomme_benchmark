diff --git a/src/mme_vla_suite/ablation.py b/src/mme_vla_suite/ablation.py
new file mode 100644
index 0000000..9d50fdb
--- /dev/null
+++ b/src/mme_vla_suite/ablation.py
@@ -0,0 +1,318 @@
+"""Inference-time memory ablations for perceptual (frame-sampling) MME-VLA policies.
+
+Three families, mirroring the LongNav navigation studies:
+
+* window   -- how many memory frames the policy sees (K counts the current frame);
+              ``recency`` keeps the newest K decision-time frames, ``uniform`` keeps K
+              evenly spaced frames over the whole episode (the model's own sampler at a
+              smaller budget).
+* prune    -- token-level selection of history memory tokens under a budget of
+              ``tokens_per_frame * k`` with a sticky per-episode ledger (a deleted token never
+              returns); the current frame's tokens are protected and not counted.
+* blind    -- from layer ``blind_from_layer`` onward no query may read visual tokens
+              (current image tokens in the joint attention, memory modulation zeroed).
+
+Everything here is numpy; the model only ever sees a 512-slot memory plus a mask, so no
+arm changes the compiled graph.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import json
+import math
+from pathlib import Path
+from typing import Callable, Literal
+
+import numpy as np
+
+from mme_vla_suite.shared.data_utils import even_sampling_indices
+
+WindowMode = Literal["recency", "uniform", "horizon"]
+PruneMethod = Literal["random", "divprune", "dart", "fastv"]
+BlindScope = Literal["visual", "memory"]
+
+
+@dataclasses.dataclass(frozen=True)
+class WindowSpec:
+    mode: WindowMode
+    k: int
+    fill: bool = False  # repeat the selected frames cyclically until all ``budget`` slots are used
+    keep: bool = False  # recency only: native frames + timestamps kept, older content hidden (see keep_window)
+
+
+@dataclasses.dataclass(frozen=True)
+class PruneSpec:
+    method: PruneMethod
+    k: int  # budget in frames' worth of history tokens (current frame excluded)
+    n_pivots: int = 8  # DART
+
+
+@dataclasses.dataclass(frozen=True)
+class AblationSpec:
+    window: WindowSpec | None = None
+    prune: PruneSpec | None = None
+    blind_from_layer: int | None = None
+    blind_scope: BlindScope = "visual"
+    seed: int = 0
+    stride: int = 16  # env steps between policy calls (decision cadence)
+
+    @classmethod
+    def from_json(cls, text_or_path: str | None) -> "AblationSpec | None":
+        if text_or_path is None or text_or_path.strip() in ("", "null", "none"):
+            return None
+        text = text_or_path
+        p = Path(text_or_path)
+        if p.suffix == ".json" and p.exists():
+            text = p.read_text()
+        d = json.loads(text)
+        if not d:
+            return None
+        window = WindowSpec(**d["window"]) if d.get("window") else None
+        prune = PruneSpec(**d["prune"]) if d.get("prune") else None
+        if window is not None and prune is not None:
+            raise ValueError("window and prune ablations are mutually exclusive")
+        return cls(
+            window=window,
+            prune=prune,
+            blind_from_layer=d.get("blind_from_layer"),
+            blind_scope=d.get("blind_scope", "visual"),
+            seed=int(d.get("seed", 0)),
+            stride=int(d.get("stride", 16)),
+        )
+
+    def to_dict(self) -> dict:
+        return dataclasses.asdict(self)
+
+    @property
+    def is_identity(self) -> bool:
+        return self.window is None and self.prune is None and self.blind_from_layer is None
+
+
+# --------------------------------------------------------------------------------------
+# Frame-level selection (window family)
+# --------------------------------------------------------------------------------------
+def decision_frames(step_idx: int, stride: int) -> list[int]:
+    """Buffer indices of the frames at which the policy is called when it runs every
+    ``stride`` env steps from step 0 (the standard client); used by tests and tooling."""
+    return list(range(0, step_idx + 1, stride))
+
+
+def select_window(step_idx: int, spec: WindowSpec, call_steps: list[int], budget: int = 32) -> list[int]:
+    """Frame indices (ascending) of the memory frames; always ends with ``step_idx``.
+
+    ``call_steps``: the buffer steps at which the policy has been called so far this episode
+    (ascending, last == step_idx). ``recency`` keeps the newest K of them; ``uniform`` keeps K
+    evenly spaced frames over all buffer steps (the model's native sampler at budget K);
+    ``horizon`` keeps the native sampler (``budget`` frames) but restricted to the newest ``k``
+    buffer steps, i.e. a window in time at the model's own frame density (count unchanged).
+    """
+    if spec.k < 1:
+        raise ValueError("window k must be >= 1 (K counts the current frame)")
+    if spec.mode == "uniform":
+        frames = even_sampling_indices(step_idx, spec.k)
+    elif spec.mode == "horizon":
+        lo = max(0, step_idx - spec.k + 1)
+        frames = [lo + i for i in even_sampling_indices(step_idx - lo, budget)]
+    elif spec.mode == "recency":
+        frames = list(call_steps)
+        if not frames or frames[-1] != step_idx:
+            frames.append(step_idx)
+        frames = frames[-spec.k :]
+    else:
+        raise ValueError(f"unknown window mode {spec.mode}")
+    if spec.fill and len(frames) < budget:
+        # count control: the same frames, duplicated so that the memory holds ``budget`` frames
+        # (the slot count is what the native sampler always fills past step 31)
+        frames = sorted(frames[i % len(frames)] for i in range(budget))
+    return frames
+
+
+def keep_window(step_idx: int, spec: WindowSpec, call_steps: list[int], budget: int = 32) -> tuple[list[int], int]:
+    """The navigation "old blocks kept" control: the native ``budget`` evenly spaced frames with
+    their own position embeddings (timestamps), where every frame older than the recency window's
+    oldest step has its visual/state content hidden. Returns (native frames, cutoff step): frames
+    at steps >= cutoff are shown as they are, older ones receive the content of the cutoff step
+    (see ``substitute_old_content``), so the memory keeps its 32-slot time structure and the
+    model sees only the window's span."""
+    cutoff = select_window(step_idx, WindowSpec("recency", spec.k), call_steps)[0]
+    return even_sampling_indices(step_idx, budget), cutoff
+
+
+def substitute_old_content(feats: dict, frames: list[int], cutoff: int, content_keys: tuple[str, ...]) -> dict:
+    """History dict for ``frames`` where entries older than ``cutoff`` carry the ``content_keys``
+    of the cutoff step (all other keys, i.e. the position embeddings, stay their own)."""
+    src = feats[cutoff]
+    out = {}
+    for i in frames:
+        if i >= cutoff:
+            out[i] = feats[i]
+        else:
+            out[i] = {k: (src[k] if k in content_keys else v) for k, v in feats[i].items()}
+    return out
+
+
+# --------------------------------------------------------------------------------------
+# Token-level selection (prune family)
+# --------------------------------------------------------------------------------------
+Token = tuple[int, int]  # (frame step index, patch index)
+
+
+def _l2n(x: np.ndarray) -> np.ndarray:
+    return x / (np.linalg.norm(x, axis=-1, keepdims=True) + 1e-8)
+
+
+def select_random(n: int, budget: int, rng: np.random.Generator) -> np.ndarray:
+    return np.sort(rng.choice(n, size=budget, replace=False))
+
+
+def select_divprune(feats: np.ndarray, budget: int) -> np.ndarray:
+    """Greedy max-min cosine-distance subset (DivPrune). ``feats``: [n, d]."""
+    n = feats.shape[0]
+    if budget >= n:
+        return np.arange(n)
+    f = _l2n(feats.astype(np.float32))
+    dist = 1.0 - f @ f.T  # cosine distance
+    # start from the token farthest from everything on average
+    chosen = [int(np.argmax(dist.sum(axis=1)))]
+    min_d = dist[chosen[0]].copy()
+    while len(chosen) < budget:
+        min_d[chosen] = -np.inf
+        nxt = int(np.argmax(min_d))
+        chosen.append(nxt)
+        min_d = np.minimum(min_d, dist[nxt])
+    return np.sort(np.asarray(chosen))
+
+
+def select_dart(feats: np.ndarray, budget: int, n_pivots: int = 8) -> np.ndarray:
+    """Duplication-aware selection (DART): pivots by largest L2 norm, each pivot keeps the
+    tokens least cosine-similar to it. ``feats``: [n, d]."""
+    n = feats.shape[0]
+    if budget >= n:
+        return np.arange(n)
+    f32 = feats.astype(np.float32)
+    n_piv = min(n_pivots, budget, n)
+    pivots = np.argsort(-np.linalg.norm(f32, axis=-1))[:n_piv]
+    f = _l2n(f32)
+    sim = f[pivots] @ f.T  # [n_piv, n]
+    kept = np.zeros(n, dtype=bool)
+    kept[pivots] = True
+    per_pivot = (budget - n_piv) // n_piv
+    for p in range(n_piv):
+        order = np.argsort(sim[p])  # least similar first
+        taken = 0
+        for j in order:
+            if taken >= per_pivot:
+                break
+            if not kept[j]:
+                kept[j] = True
+                taken += 1
+    # fill any remainder (budget not divisible) with globally least-similar-to-pivots tokens
+    if kept.sum() < budget:
+        order = np.argsort(sim.max(axis=0))
+        for j in order:
+            if kept.sum() >= budget:
+                break
+            kept[j] = True
+    return np.flatnonzero(kept)
+
+
+class TokenLedger:
+    """Sticky per-episode set of surviving history tokens.
+
+    At every policy call the previous decision frame's tokens join the survivors; the selector
+    then keeps at most ``tokens_per_frame * k`` of them. Tokens that are dropped never return.
+    """
+
+    def __init__(
+        self,
+        spec: PruneSpec,
+        tokens_per_frame: int,
+        seed: int,
+        episode: int,
+        feature_fn: Callable[[list[Token]], np.ndarray] | None = None,
+    ):
+        self.spec = spec
+        self.tpf = tokens_per_frame
+        self.budget = tokens_per_frame * spec.k
+        self.feature_fn = feature_fn
+        self.rng = np.random.default_rng([seed, episode, 7919])
+        self.survivors: list[Token] = []
+        self.seen_frames: list[int] = []
+        self.n_calls = 0
+
+    def update(self, new_frames: list[int]) -> list[Token]:
+        """Add ``new_frames`` (whole frames) to the candidate pool and prune to the budget."""
+        for s in new_frames:
+            if s in self.seen_frames:
+                continue
+            self.seen_frames.append(s)
+            self.survivors.extend((s, p) for p in range(self.tpf))
+        self.n_calls += 1
+        n = len(self.survivors)
+        if n <= self.budget:
+            return list(self.survivors)
+        if self.budget == 0:
+            self.survivors = []
+            return []
+        m = self.spec.method
+        if m == "random":
+            keep = select_random(n, self.budget, self.rng)
+        else:
+            if self.feature_fn is None:
+                raise ValueError(f"{m} needs a feature_fn")
+            feats = self.feature_fn(self.survivors)
+            if m == "divprune":
+                keep = select_divprune(feats, self.budget)
+            elif m == "dart":
+                keep = select_dart(feats, self.budget, self.spec.n_pivots)
+            else:
+                raise ValueError(f"unknown prune method {m}")
+        self.survivors = [self.survivors[i] for i in keep]
+        self.survivors.sort()
+        return list(self.survivors)
+
+
+# --------------------------------------------------------------------------------------
+# Memory assembly in the model's 512-slot layout
+# --------------------------------------------------------------------------------------
+def build_token_inputs(
+    history_feats: dict,
+    tokens: list[Token],
+    budget_slots: int,
+    tokens_per_frame: int,
+    img_dim: int,
+    pos_dim: int,
+    state_dim: int,
+) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    """Place the given (frame, patch) tokens into the fixed memory slots; mask the rest."""
+    side = int(math.sqrt(tokens_per_frame))
+    key = f"{side}x{side}"
+    if len(tokens) > budget_slots:
+        raise ValueError(f"{len(tokens)} tokens exceed the {budget_slots} memory slots")
+    img = np.zeros((budget_slots, img_dim), dtype=np.float32)
+    pos = np.zeros((budget_slots, pos_dim), dtype=np.float32)
+    state = np.zeros((budget_slots, state_dim), dtype=np.float32)
+    mask = np.zeros((budget_slots,), dtype=np.bool_)
+    for i, (s, p) in enumerate(sorted(tokens)):
+        f = history_feats[s]
+        img[i] = f[f"image_emb_{key}"][0][p]
+        pos[i] = f[f"pos_emb_{key}"][0][p]
+        state[i] = f["state_emb"]
+        mask[i] = True
+    return img, pos, state, mask
+
+
+def blind_vectors(depth: int, blind_from_layer: int | None, scope: BlindScope) -> tuple[np.ndarray, np.ndarray]:
+    """(blind_visual[depth], blind_memory[depth]) booleans; all False = identity."""
+    vis = np.zeros((depth,), dtype=np.bool_)
+    mem = np.zeros((depth,), dtype=np.bool_)
+    if blind_from_layer is not None:
+        if not 0 <= blind_from_layer <= depth:
+            raise ValueError(f"blind_from_layer must be in [0, {depth}]")
+        mem[blind_from_layer:] = True
+        if scope == "visual":
+            vis[blind_from_layer:] = True
+        elif scope != "memory":
+            raise ValueError(f"unknown blind scope {scope}")
+    return vis, mem
