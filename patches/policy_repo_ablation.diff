index 0000000..118486a
--- /dev/null
+++ b/scripts/ablation_check_client.py
@@ -0,0 +1,77 @@
+"""Deterministic synthetic episode against a running policy server; saves the returned action
+chunks so two servers (e.g. unpatched vs patched, or two ablation settings) can be compared.
+
+    python scripts/ablation_check_client.py --port 18763 --out /path/run.npz [--n-calls 40]
+    python scripts/ablation_check_client.py --compare a.npz b.npz
+
+Needs only numpy + openpi_client (the simulator venv has both).
+"""
+
+import argparse
+import hashlib
+import time
+
+import numpy as np
+
+
+def run(port: int, host: str, n_calls: int, stride: int, seed: int, out: str) -> None:
+    from openpi_client import websocket_client_policy as wcp
+
+    rng = np.random.default_rng(seed)
+    client = wcp.MMEVLAWebsocketClientPolicy(host, port)
+    resp = client.reset()
+    while not resp.get("reset_finished", False):
+        time.sleep(0.1)
+
+    def frame():
+        img = rng.integers(0, 256, size=(224, 224, 3), dtype=np.uint8)
+        wrist = rng.integers(0, 256, size=(224, 224, 3), dtype=np.uint8)
+        state = np.concatenate([rng.uniform(-1.5, 1.5, size=7), [1.0]]).astype(np.float32)
+        return img, wrist, state
+
+    actions, times = [], []
+    pending = [frame()]  # first call: one initial frame (like a non-video RoboMME task)
+    for c in range(n_calls):
+        imgs = np.stack([p[0] for p in pending])[:, None]
+        states = np.stack([p[2] for p in pending])
+        resp = client.add_buffer({"images": imgs, "state": states, "add_buffer": True, "exec_start_idx": 0})
+        while not resp.get("add_buffer_finished", False):
+            time.sleep(0.1)
+        img, wrist, state = pending[-1]
+        out_c = client.infer({
+            "observation/image": img,
+            "observation/wrist_image": wrist,
+            "observation/state": state,
+            "prompt": "pick up the green cube 3 times",
+        })
+        actions.append(np.asarray(out_c["actions"], dtype=np.float32))
+        times.append(float(out_c.get("infer_time_ms", np.nan)))
+        pending = [frame() for _ in range(stride)]
+    acts = np.stack(actions)
+    np.savez(out, actions=acts, infer_time_ms=np.asarray(times))
+    print(f"saved {out}: actions {acts.shape}, md5 {hashlib.md5(acts.tobytes()).hexdigest()}, "
+          f"mean infer {np.nanmean(times[1:]):.1f} ms")
+
+
+def compare(a: str, b: str) -> None:
+    A, B = np.load(a)["actions"], np.load(b)["actions"]
+    assert A.shape == B.shape, (A.shape, B.shape)
+    diff = np.abs(A - B)
+    print(f"max |diff| {diff.max():.3e}, mean {diff.mean():.3e}, bit-identical: {np.array_equal(A, B)}, "
+          f"calls differing: {int((diff.reshape(len(A), -1).max(axis=1) > 0).sum())}/{len(A)}")
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--port", type=int, default=18763)
+    ap.add_argument("--n-calls", type=int, default=40)
+    ap.add_argument("--stride", type=int, default=16)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out", default="ablation_check.npz")
+    ap.add_argument("--compare", nargs=2, metavar=("A", "B"))
+    args = ap.parse_args()
+    if args.compare:
+        compare(*args.compare)
+    else:
+        run(args.port, args.host, args.n_calls, args.stride, args.seed, args.out)
